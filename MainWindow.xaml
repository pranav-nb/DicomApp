<Window x:Class="DicomApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DICOM File Processor" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10">
            <Button Content="Select Folder" Click="Button_Click"/>
            <Button Content="Export to CSV" Click="ExportToCSVButton_Click" Margin="10,0,0,0"/>
            <TextBox x:Name="searchTextBox" Text="Enter search term" Width ="100" Margin="30,0,0,0" VerticalAlignment="Center" GotFocus="SearchTextBox_GotFocus" LostFocus="SearchTextBox_LostFocus"/>
            <Button Content="Search by Text" Click="SearchByTextButton_Click" Margin="30,0,0,0"/>
            <Button Content="Search by DICOM Tag" Click="SearchByTagButton_Click" Margin="10,0,0,0"/>
            <Button Content="Reset" Click="ResetButton_Click" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top"/>
        </StackPanel>
        <ListBox x:Name="lb" Grid.Row="1" Margin="10" />
        <DataGrid x:Name="attributesDataGrid" Grid.Row="1" AutoGenerateColumns="True"/>
    </Grid>
</Window>
